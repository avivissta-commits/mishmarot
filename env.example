# Copy to `.env` and set your deployed Cloudflare Worker URL.
# Used at build time by Vite (see src/api.js resolveBase()).
VITE_API_URL=https://shiftapp-api.your-subdomain.workers.dev

# Base path for GitHub Pages project sites: "/<repo>/".
# Leave unset (defaults to "/") for user pages or custom domains.
# VITE_BASE=/shiftapp/
